{
  "name": "backend-tp2-pio-socket",
  "version": "1.0.0",
  "description": "Backend base para el TP2 (Pio Socket) - Router, searchParams y Socket.IO",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "pio": "nodemon --env-file=.pio.env index.js",
    "home": "nodemon --env-file=.home.env index.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "node ./node_modules/@yao-pkg/pkg/lib-es5/bin.js . --targets node18-win-x64 --output build/backend-tp2.exe"
  },
  "keywords": [
    "socket.io",
    "express",
    "nextjs",
    "backend"
  ],
  "author": "Ing. Pablo Morandi",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14"
  }
}
